{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "glitchpage",
  "type": "registry:theme",
  "description": "GLITCHPAGE — error page, neon pink/cyan glitch, scanlines, Thai",
  "cssVars": {
    "light": {
      "accent": "#ff3d8f",
      "accent-2": "#37e6ff",
      "accent-foreground": "hsl(230 53% 10%)",
      "background": "#0b0f2a",
      "border": "#232a5e",
      "border-width": "1px",
      "card": "#111640",
