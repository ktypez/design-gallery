{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "portal",
  "type": "registry:theme",
  "description": "INK // portal — bold editorial — ink page, electric accent, Thai-first type (Kanit + IBM Plex Sans Thai)",
  "cssVars": {
    "light": {
      "accent": "#3f5c05",
      "accent-foreground": "#f6f5ef",
      "accent-soft": "rgba(60, 92, 5, 0.1)",
      "background": "#f6f5ef",
      "border": "#e2ded2",
      "card": "#ffffff",
      "card-foreground": "#17170f",
      "danger-border": "rgba(214, 69, 69, 0.35)",
      "danger-soft": "rgba(214, 69, 69, 0.12)",
      "destructive": "#d64545",
      "destructive-foreground": "#ffffff",
      "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
      "font-display": "'Kanit', 'IBM Plex Sans Thai', system-ui, sans-serif",
      "font-mono": "ui-monospace, 'SF Mono', 'IBM Plex Sans Thai', monospace",
      "font-sans": "'IBM Plex Sans Thai', system-ui, sans-serif",
      "foreground": "#17170f",
      "input": "#e2ded2",
      "muted": "#efece2",
      "muted-foreground": "#4a483d",
      "muted-text": "#8a8778",
      "popover": "#ffffff",
      "popover-foreground": "#17170f",
      "primary": "#3f5c05",
      "primary-foreground": "#f6f5ef",
      "radius": "14px",
      "radius-sm": "10px",
      "ring": "#c9c4b4",
      "secondary": "#f0ede3",
      "secondary-foreground": "#17170f",
      "shadow": "0 1px 2px rgba(23, 23, 15, 0.05), 0 8px 24px -18px rgba(23, 23, 15, 0.12)",
      "shadow-lg": "0 12px 40px rgba(23, 23, 15, 0.18)",
      "shadow-md": "0 4px 12px rgba(23, 23, 15, 0.08)",
      "success": "#1f9d5c"
    },
    "dark": {
      "accent": "#d6ff3f",
      "accent-foreground": "#10120a",
      "accent-soft": "rgba(214, 255, 63, 0.1)",
      "background": "#0c0d0f",
      "border": "#26292f",
      "card": "#16181c",
      "card-foreground": "#f2f0e8",
      "danger-border": "rgba(255, 92, 92, 0.35)",
      "danger-soft": "rgba(255, 92, 92, 0.12)",
      "destructive": "#ff5c5c",
      "destructive-foreground": "#ffffff",
      "foreground": "#f2f0e8",
      "input": "#26292f",
      "muted": "#111316",
      "muted-foreground": "#b6b2a6",
      "muted-text": "#7a7d85",
      "popover": "#16181c",
      "popover-foreground": "#f2f0e8",
      "primary": "#d6ff3f",
      "primary-foreground": "#10120a",
      "ring": "#33373e",
      "secondary": "#1c1f24",
      "secondary-foreground": "#f2f0e8",
      "shadow": "0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px -18px rgba(0, 0, 0, 0.6)",
      "shadow-lg": "0 12px 40px rgba(0, 0, 0, 0.6)",
      "shadow-md": "0 4px 12px rgba(0, 0, 0, 0.4)",
      "success": "#3ddc84"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    }
  },
  "meta": {
    "name": "INK // portal",
    "vibe": "bold editorial — ink page, electric accent, Thai-first type (Kanit + IBM Plex Sans Thai)",
    "mode": "dual"
  }
}